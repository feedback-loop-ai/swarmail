{
  "name": "self",
  "policy": "policy.json",
  "protected_phase": "review",
  "seats": {
    "implement": {
      "agent": "implementer",
      "class": "work",
      "results": [
        "complete",
        "broken",
        "blocked"
      ],
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 7200
      }
    },
    "intake": {
      "agent": "intake",
      "class": "work",
      "results": [
        "resolved"
      ]
    },
    "review": {
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "inputs": [
        "fixes_applied",
        "has_security_residual",
        "max_residual_severity",
        "spec_defect"
      ],
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 3600
      },
      "aggregate": "review-panel",
      "panel": {
        "correctness": {
          "agent": "review-correctness",
          "class": "gate"
        },
        "security": {
          "agent": "review-security",
          "class": "gate"
        },
        "guarantees": {
          "agent": "review-guarantees",
          "class": "gate"
        },
        "tests": {
          "agent": "review-tests",
          "class": "gate"
        }
      }
    },
    "ship": {
      "class": "gate",
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./scripts/ship-seat.sh",
          "{prompt_file}",
          "{brokkr}"
        ]
      },
      "hands": {
        "binds": [],
        "kind": "workspace",
        "network": false
      },
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 1800
      },
      "results": [
        "ready",
        "shipped"
      ]
    },
    "verify": {
      "class": "gate",
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./scripts/verify-seat.sh",
          "{prompt_file}",
          "{brokkr}"
        ]
      },
      "hands": {
        "binds": [
          {
            "mask": [
              "credentials.toml",
              "credentials"
            ],
            "mode": "overlay",
            "path": "~/.cargo"
          },
          {
            "mode": "ro",
            "path": "~/.rustup"
          }
        ],
        "kind": "workspace",
        "network": false
      },
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 10800
      },
      "results": [
        "pass",
        "fail"
      ]
    },
    "design": {
      "results": [
        "designed",
        "drafted",
        "fail"
      ],
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 14400
      },
      "sequence": [
        {
          "name": "positions",
          "aggregate": "unanimous-pass",
          "panel": {
            "simplicity": {
              "agent": "codex-position-simplicity"
            },
            "robustness": {
              "agent": "codex-position-robustness"
            }
          }
        },
        {
          "name": "chief",
          "agent": "codex-chief-architect",
          "results": [
            "drafted"
          ]
        },
        {
          "name": "check",
          "class": "gate",
          "driver": {
            "command": [
              "{brokkr}",
              "driver",
              "exec",
              "--",
              "bash",
              "./scripts/design-check.sh",
              "{prompt_file}"
            ]
          },
          "hands": {
            "binds": [],
            "kind": "workspace",
            "network": false
          }
        }
      ]
    }
  },
  "description": "Swarmail's own delivery constitution: the hybrid machine \u2014 a contrarian design panel argues before any code (positions \u2192 chief \u2192 deterministic design-check), implement builds, hermetic gates verify, a four-member review panel judges (correctness, security, guarantees and tests, decision 0013; the protected phase), and ship records the ledger. The default intake and implement seats use glm-flash; the shared design council uses Codex Sol/Astra (0057); each review member runs its own model route with a glm-flash fallback; verify, ship and the design check are hermetic exec gates."
}
