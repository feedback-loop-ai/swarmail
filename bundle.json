{
  "name": "self",
  "policy": "policy.json",
  "protected_phase": "review",
  "seats": {
    "implement": {
      "agent": "implementer",
      "class": "work",
      "results": [
        "complete",
        "broken",
        "blocked"
      ],
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 7200
      }
    },
    "intake": {
      "agent": "intake",
      "class": "work",
      "results": [
        "resolved"
      ]
    },
    "review": {
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "inputs": [
        "fixes_applied",
        "has_security_residual",
        "max_residual_severity"
      ],
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 3600
      },
      "aggregate": "review-panel",
      "panel": {
        "correctness": {
          "agent": "review-correctness",
          "class": "gate"
        },
        "security": {
          "agent": "review-security",
          "class": "gate"
        },
        "guarantees": {
          "agent": "review-guarantees",
          "class": "gate"
        },
        "tests": {
          "agent": "review-tests",
          "class": "gate"
        }
      }
    },
    "ship": {
      "class": "gate",
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./scripts/ship-seat.sh",
          "{prompt_file}",
          "{brokkr}"
        ]
      },
      "hands": {
        "binds": [],
        "kind": "workspace",
        "network": false
      },
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 1800
      },
      "results": [
        "ready",
        "shipped"
      ]
    },
    "verify": {
      "class": "gate",
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./scripts/verify-seat.sh",
          "{prompt_file}"
        ]
      },
      "hands": {
        "binds": [
          {
            "mask": [
              "credentials.toml",
              "credentials"
            ],
            "mode": "overlay",
            "path": "~/.cargo"
          },
          {
            "mode": "ro",
            "path": "~/.rustup"
          }
        ],
        "kind": "workspace",
        "network": false
      },
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "results": [
        "pass",
        "fail"
      ]
    },
    "design": {
      "results": [
        "designed",
        "drafted",
        "fail"
      ],
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 14400
      },
      "sequence": [
        {
          "name": "positions",
          "aggregate": "unanimous-pass",
          "panel": {
            "simplicity": {
              "agent": "position-simplicity"
            },
            "robustness": {
              "agent": "position-robustness"
            }
          }
        },
        {
          "name": "chief",
          "agent": "chief-architect"
        }
      ]
    }
  },
  "description": "Swarmail's own delivery constitution: the hybrid machine — a contrarian design panel argues before any code (positions → chief → deterministic design-check), implement builds, hermetic gates verify, a split review panel judges (correctness + security, the protected phase), and ship signs. Model seats run glm-flash (spark-glm/GLM-5.3-Flash-EXL3) via the dsh driver; verify, ship and the design check are hermetic exec gates."
}
