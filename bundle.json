{
  "name": "self",
  "policy": "policy.json",
  "protected_phase": "review",
  "seats": {
    "implement": {
      "agent": "implementer",
      "class": "work",
      "results": [
        "complete",
        "broken",
        "blocked"
      ]
    },
    "intake": {
      "agent": "intake",
      "class": "work",
      "results": [
        "resolved"
      ]
    },
    "review": {
      "agent": "reviewer",
      "class": "gate",
      "results": [
        "clean",
        "residual",
        "security-hold"
      ]
    },
    "ship": {
      "class": "gate",
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./scripts/ship-seat.sh",
          "{prompt_file}",
          "{brokkr}"
        ]
      },
      "hands": {
        "binds": [],
        "kind": "workspace",
        "network": false
      },
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 1800
      },
      "results": [
        "ready",
        "shipped"
      ]
    },
    "verify": {
      "class": "gate",
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./scripts/verify-seat.sh",
          "{prompt_file}"
        ]
      },
      "hands": {
        "binds": [
          {
            "mask": [
              "credentials.toml",
              "credentials"
            ],
            "mode": "overlay",
            "path": "~/.cargo"
          },
          {
            "mode": "ro",
            "path": "~/.rustup"
          }
        ],
        "kind": "workspace",
        "network": false
      },
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "results": [
        "pass",
        "fail"
      ]
    }
  },
  "description": "Swarmail's own delivery constitution: the fast recipe's phase machine and seats as the compiled, digest-pinned bundle of the repo it governs. All model seats run glm-flash (spark-glm/GLM-5.3-Flash-EXL3) via the dsh driver; verify and ship are hermetic exec gates."
}
